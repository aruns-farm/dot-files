# ============================================================
# Brewfile — Arun's Dev Setup
# Run: brew bundle
# ============================================================

# ── Core / Shell ─────────────────────────────────────────────
brew "git"
brew "git-crypt"         # encrypt secrets inside git repos
brew "gpg"               # signing commits + git-crypt dependency
brew "delta"             # beautiful git diffs
brew "lazygit"           # terminal UI for git
brew "gh"                # GitHub CLI

# ── Shell Experience ─────────────────────────────────────────
brew "zsh-autosuggestions"
brew "zsh-syntax-highlighting"
brew "starship"          # fast, minimal shell prompt
brew "fzf"               # fuzzy finder
brew "zoxide"            # smarter cd (learns your dirs)
brew "direnv"            # auto-load .env when you cd into a project

# ── Terminal Utilities ───────────────────────────────────────
brew "tmux"              # terminal multiplexer — keeps sessions alive
brew "bat"               # better cat with syntax highlighting
brew "eza"               # modern ls with git status
brew "fd"                # fast modern find
brew "ripgrep"           # fast code search (rg)
brew "jq"                # JSON parser for terminal
brew "tldr"              # simplified man pages
brew "httpie"            # human-friendly HTTP client

# ── Editor ───────────────────────────────────────────────────
brew "neovim"            # the main editor

# ── Node / JS ────────────────────────────────────────────────
brew "nvm"               # node version manager
# Note: pnpm installed via npm after nvm setup (see setup.sh)

# ── Python ───────────────────────────────────────────────────
brew "pyenv"             # python version manager
brew "pre-commit"        # git hooks manager

# ── Cloudflare ───────────────────────────────────────────────
brew "cloudflared"       # cloudflare tunnel CLI

# ── Security / Secrets ───────────────────────────────────────
brew "bitwarden-cli"     # bw CLI for secrets

# ── Mac Utilities ────────────────────────────────────────────
brew "mas"               # Mac App Store CLI

# ── GUI Apps (Casks) ─────────────────────────────────────────
cask "iterm2"            # better terminal
cask "visual-studio-code"

# ── Mac App Store Apps ───────────────────────────────────────
# Uncomment if you want these installed via mas:
# mas "Bitwarden", id: 1352778147
