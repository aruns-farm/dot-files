# Copy to ~/.ssh/config and: chmod 600 ~/.ssh/config
#
# "github-office" / "github-personal" are aliases — they are NOT real hostnames.
# They only work after this file exists (see: ssh -G github-office).
#
# With Bitwarden SSH agent, keys live in the vault; do not set IdentityFile to
# ~/.ssh/... unless those files exist. Let the agent offer keys (SSH_AUTH_SOCK).

Host github-office
  HostName github.com
  User git

Host github-personal
  HostName github.com
  User git
